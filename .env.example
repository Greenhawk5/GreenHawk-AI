# =====================================================
# GreenHawk AI - Environment Configuration Example
# =====================================================
# Copy this file to ".env" and update values according
# to your local environment.
#
# IMPORTANT:
# Never commit your real .env file or API keys.
# =====================================================


# -----------------------------------------------------
# Application Environment
# -----------------------------------------------------

# Application mode
# Options:
# development
# production

APP_ENV=development


# Debug mode
# Enable/disable detailed error messages

DEBUG=true



# -----------------------------------------------------
# Backend Configuration
# -----------------------------------------------------

# Backend server host

BACKEND_HOST=127.0.0.1


# Backend server port

BACKEND_PORT=8000



# -----------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------

# Frontend application URL

FRONTEND_URL=http://localhost:5173



# -----------------------------------------------------
# AI Model Services
# -----------------------------------------------------

# Zhang Colorization
# Local model files are managed by backend configuration

ZHANG_MODEL_ENABLED=true


# DeOldify service configuration

DEOLDIFY_ENABLED=true


# FLUX / Generative AI service configuration

FLUX_ENABLED=true



# -----------------------------------------------------
# External AI API Keys
# -----------------------------------------------------

# HuggingFace API Token
# Required only if using private models or authenticated requests

HUGGINGFACE_TOKEN=


# NVIDIA / External AI API Key (if enabled)

NVIDIA_API_KEY=



# -----------------------------------------------------
# Storage Configuration
# -----------------------------------------------------

# Directory for uploaded images

UPLOAD_DIR=storage/uploads


# Directory for generated outputs

OUTPUT_DIR=storage/outputs



# Maximum uploaded image size (MB)

MAX_UPLOAD_SIZE_MB=10



# -----------------------------------------------------
# Logging Configuration
# -----------------------------------------------------

LOG_LEVEL=INFO



# -----------------------------------------------------
# Security Configuration
# -----------------------------------------------------

# Secret key used for application security features

SECRET_KEY=change_this_secret_key



# Allowed frontend origins

CORS_ORIGINS=http://localhost:5173